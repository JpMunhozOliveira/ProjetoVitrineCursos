{
  "name": "vitrine-cursos-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend da plataforma Vitrine de Cursos",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:migrate": "node-pg-migrate up -m migrations",
    "db:rollback": "node-pg-migrate down -m migrations",
    "db:new": "node-pg-migrate create -m migrations",
    "admin:user": "node scripts/admin-user.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
