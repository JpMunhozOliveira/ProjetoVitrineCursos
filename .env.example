# Gere o .env com: node scripts/gerar-env.js (preenche as senhas e chaves com valores aleatórios).

# Banco de dados. POSTGRES_USER é o dono (migrations e backups); APP_DB_USER é o usuário do app,
# que só lê e grava dados.
POSTGRES_DB=vitrine_cursos
POSTGRES_USER=vitrine_app
POSTGRES_PASSWORD=troque_por_uma_senha_forte
APP_DB_USER=vitrine_web
APP_DB_PASSWORD=troque_por_outra_senha_forte

# Chave da API administrativa para scripts (mínimo 32 caracteres; vazia = desativada).
ADMIN_API_KEY=troque_por_uma_chave_longa_e_aleatoria

# Chave mestra que criptografa as chaves das contas Kiwify (32 bytes em base64). Guarde uma cópia.
KIWIFY_ENCRYPTION_KEY=

# true em produção (cookie do painel só em HTTPS).
COOKIE_SECURE=false

# --- Produção (docs/DEPLOY.md) ---
# Descomente no servidor para usar HTTPS com o Caddy:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PATH_SEPARATOR=:
# Domínio sem https:// e sem www (ex.: seusite.com.br) e e-mail para avisos do certificado HTTPS.
DOMAIN=
ACME_EMAIL=
