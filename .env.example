# Gere o .env com: node scripts/gerar-env.js (cria senha e chave aleatórias).
# Se copiar este arquivo à mão, troque POSTGRES_PASSWORD, APP_DB_PASSWORD e ADMIN_API_KEY antes de iniciar.
POSTGRES_DB=vitrine_cursos
POSTGRES_USER=vitrine_app
POSTGRES_PASSWORD=troque_por_uma_senha_local_forte
# Usuário do banco usado pelo app: só lê e grava dados (o POSTGRES_USER acima fica para as
# migrations e os backups). Criado/atualizado automaticamente a cada "docker compose up".
APP_DB_USER=vitrine_web
APP_DB_PASSWORD=troque_por_outra_senha_forte

# Credenciais da API Kiwify (preencher quando configurarmos a integração).
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=

# Chave para scripts/automações acessarem a API administrativa (vazia = desativada).
# A API recusa esta chave de exemplo e chaves com menos de 32 caracteres.
ADMIN_API_KEY=troque_por_uma_chave_longa_e_aleatoria

# Cookie de sessão do painel só trafega em HTTPS quando true. Use true em produção (site com HTTPS).
COOKIE_SECURE=false

# --- Produção (passo a passo: docs/DEPLOY.md) ---
# No servidor, descomente para usar o docker-compose.prod.yml (HTTPS com Caddy) e ignorar o
# docker-compose.override.yml (modo desenvolvimento). Com ele, PUBLIC_URL, TRUST_PROXY e
# COOKIE_SECURE são definidos automaticamente a partir de DOMAIN (não precisa preenchê-los).
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PATH_SEPARATOR=:
# Domínio do site, sem https:// e sem www (o www redireciona para ele). Ex.: seusite.com.br
DOMAIN=
# E-mail para avisos do certificado HTTPS (Let's Encrypt), ex.: renovação que falhou.
ACME_EMAIL=

# Sem o docker-compose.prod.yml (outro proxy na frente), preencha à mão:
# Endereço público do site (prévias de link no WhatsApp/redes e link canônico). Ex.: https://www.seusite.com.br
PUBLIC_URL=
# Quantos proxies (Nginx, Caddy, Cloudflare...) ficam na frente da API. Normalmente 1; vazio = nenhum.
# Nunca use "true": qualquer visitante poderia falsificar o próprio IP e escapar do limite de login.
TRUST_PROXY=
